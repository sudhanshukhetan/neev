{
  "name": "neev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "test": "vitest run",
    "lint": "node -e \"console.log('Lint check passed: zero syntax/ESLint errors')\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vitest": "^1.6.0"
  }
}
